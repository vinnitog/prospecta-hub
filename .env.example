PORT=4317
HOST=127.0.0.1
PROSPECTA_ORIGIN=http://127.0.0.1:4317
# Sem login: servidor restrito a este computador.
# Para GitHub Pages, os dados ficam no navegador; nenhum servidor é necessário.
PROSPECTA_DB_PATH=./data/prospecta.sqlite
PROSPECTA_CONTEXT_PATH=./private/leads-contexto.json
# simulation nunca chama a Meta. Não reutilize as flags globais WHATSAPP_* do Coleus.
PROSPECTA_WHATSAPP_MODE=simulation
# shared fica bloqueado para envio real nesta versão. Consulte docs/INTEGRACAO_META.md.
PROSPECTA_WHATSAPP_TOPOLOGY=shared
PROSPECTA_WHATSAPP_ACCESS_TOKEN=
PROSPECTA_WHATSAPP_PHONE_NUMBER_ID=
PROSPECTA_WHATSAPP_API_VERSION=
PROSPECTA_WHATSAPP_VERIFY_TOKEN=
PROSPECTA_WHATSAPP_APP_SECRET=
# ID do remetente protegido: obrigatório para validar um número dedicado diferente.
PROSPECTA_COLEUS_PHONE_NUMBER_ID=
# Templates aprovados e sem variáveis, separados por vírgula; idioma configurado na Meta.
PROSPECTA_WHATSAPP_TEMPLATES=
PROSPECTA_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
